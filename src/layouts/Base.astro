---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import "../styles/fonts.css";

const ease = "cubic-bezier(0.23, 1, 0.32, 1)";
const leave = {
  name: "page-out",
  duration: "0.22s",
  easing: ease,
  fillMode: "both",
};
const arrive = {
  name: "page-in",
  duration: "0.45s",
  easing: ease,
  fillMode: "both",
};
const crossfade = {
  forwards: { old: leave, new: arrive },
  backwards: { old: leave, new: arrive },
};

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Personal portfolio",
  noindex = false,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/portfolio-og.png", Astro.site).href;
const twitterImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en" transition:animate={crossfade}>
  <head>
    <ClientRouter />
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    >
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    {!noindex && <link rel="canonical" href={pageUrl}>}
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0a0a0a">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="sitemap" href="/sitemap-index.xml">
    <link
      rel="preload"
      href="/fonts/JetBrainsMonoNF-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >
    <title>{title}</title>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {!noindex && <meta property="og:url" content={pageUrl}>}
    <meta property="og:image" content={ogImage}>
    <meta
      property="og:image:alt"
      content="Ravinath Rajapakshe, Developer &amp; Designer. A cat avatar overlaps a field of orange poppies."
    >
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={twitterImage}>
    <meta name="twitter:image:alt" content="Ravinath Rajapakshe">
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(() => {
        if (!document.documentElement.classList.contains("revealed")) {
          document.documentElement.classList.remove("js");
        }
      }, 2500);
    </script>
    <script>
      const root = document.documentElement;
      if (!root.dataset.navBound) {
        root.dataset.navBound = "";
        document.addEventListener("astro:after-swap", () => {
          root.classList.add("is-navigating");
        });
      }
    </script>
    <Analytics />
  </head>
  <body>
    <slot />
    <div class="edge-blur" aria-hidden="true">
      <div></div>
      <div></div>
      <div></div>
    </div>
    <div class="edge-fade" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0a0a;
    --fg: #ededed;
    --muted: #808080;
    --underline: rgba(255, 255, 255, 0.25);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);

    --edge-blur-height: 15svh;
    --edge-fade-height: 0px;
    --page-width: 692px;
    --gutter-left: max(1.5rem, env(safe-area-inset-left, 0px));
    --gutter-right: max(1.5rem, env(safe-area-inset-right, 0px));
    --mono:
      "JetBrainsMono NF", "JetBrains Mono", ui-monospace, Menlo, monospace;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 100%;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-variant-ligatures: none;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  body {
    margin: 0;
    font-size: 1rem;
    min-height: 100svh;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: max(
      var(--edge-blur-height),
      var(--edge-fade-height),
      env(safe-area-inset-bottom, 0px)
    );
    background: var(--bg);
  }

  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  a {
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-color: var(--underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    touch-action: manipulation;
  }

  a:active {
    text-decoration-color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    a {
      text-decoration: none;
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 calc(100% - 0.08em);
      background-size: 0 1px;
    }

    a:hover,
    a:focus-visible {
      background-size: 100% 1px;
    }

    .prose a {
      text-decoration-line: underline;
      text-decoration-color: var(--underline);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.3em;
      background-image: none;
    }
  }

  @media (hover: hover) and (pointer: fine) and (
      prefers-reduced-motion: no-preference
    ) {
    a {
      transition:
        background-size 180ms var(--ease-out),
        color 150ms var(--ease-out);
    }
  }

  a:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .prompt {
    color: var(--muted);
  }

  .cmd:focus-within .prompt,
  .cmd:has(a:active) .prompt {
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .cmd .prompt {
      transition: color 150ms ease;
    }

    .cmd:has(a:hover) .prompt {
      color: var(--fg);
    }
  }

  .edge-blur {
    position: fixed;
    inset: auto 0 0 0;
    height: var(--edge-blur-height);
    z-index: 10;
    pointer-events: none;
  }

  .edge-blur > div,
  .edge-blur::before,
  .edge-blur::after {
    position: absolute;
    inset: 0;
  }

  .edge-blur::before {
    content: "";
    z-index: 1;
    -webkit-backdrop-filter: blur(1px);
    backdrop-filter: blur(1px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 20%,
      rgba(0, 0, 0, 1) 40%,
      rgba(0, 0, 0, 0) 60%
    );
  }

  .edge-blur > div:nth-of-type(1) {
    z-index: 2;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 20%,
      rgba(0, 0, 0, 1) 40%,
      rgba(0, 0, 0, 1) 60%,
      rgba(0, 0, 0, 0) 80%
    );
  }

  .edge-blur > div:nth-of-type(2) {
    z-index: 3;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 40%,
      rgba(0, 0, 0, 1) 60%,
      rgba(0, 0, 0, 1) 80%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .edge-blur > div:nth-of-type(3) {
    z-index: 4;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 60%,
      rgba(0, 0, 0, 1) 80%,
      rgba(0, 0, 0, 1) 100%
    );
  }

  .edge-blur::after {
    content: "";
    z-index: 5;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 80%,
      rgba(0, 0, 0, 1) 100%
    );
  }

  @media (any-pointer: coarse) {
    a:active {
      background-color: rgb(255 255 255 / 12%);
    }
  }

  .edge-fade {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    height: var(--edge-fade-height);
    z-index: 10;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  @media (pointer: coarse), (prefers-reduced-transparency: reduce) {
    :root {
      --edge-blur-height: 0px;
      --edge-fade-height: 14svh;
    }

    .edge-fade {
      display: block;
    }
  }

  @supports (-webkit-touch-callout: none) {
    :root {
      --edge-blur-height: 0px;
      --edge-fade-height: 14svh;
    }

    .edge-fade {
      display: block;
    }
  }

  .js [data-reveal]:not([data-reveal="self"]) > :not(ul, ol, dl),
  .js [data-reveal]:not([data-reveal="self"]) > :is(ul, ol, dl) > *,
  .js [data-reveal]:not(:has(> *)),
  .js [data-reveal="self"] {
    opacity: 0;
  }

  html.is-navigating
    :is(
      [data-reveal="self"],
      [data-reveal]:not([data-reveal="self"]) > :not(ul, ol, dl),
      [data-reveal]:not([data-reveal="self"]) > :is(ul, ol, dl) > *,
      [data-reveal]:not(:has(> *))
    ) {
    opacity: 1;
  }

  @keyframes page-out {
    to {
      opacity: 0;
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  [data-reveal] > :is(a, time) {
    display: inline-block;
  }
</style>

---
interface Props {
  segments: { label: string; href: string }[];
}

const { segments } = Astro.props;
const trail = [{ label: "~", href: "/" }, ...segments];
const copyPath = `~/${segments.map((segment) => segment.label).join("/")}`;
---

<nav class="path" aria-label="Breadcrumb">
  {trail.map((segment, i) => (
    <>
      {i > 0 && (
        <span class="sep" aria-hidden="true">
          /
        </span>
      )}
      {i < trail.length - 1 ? (
        <a href={segment.href}>{segment.label}</a>
      ) : (
        <button
          type="button"
          data-path={copyPath}
          aria-current="page"
          aria-label={`Copy ${copyPath}`}
        >
          <span class="label">{segment.label}</span>
        </button>
      )}
    </>
  ))}
  <span class="sr" aria-live="polite"></span>
</nav>

<style>
  .path {
    position: relative;
    font-size: 0.875rem;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .path a,
  .sep {
    color: var(--muted);
  }

  .path button {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    line-height: inherit;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
  }

  .path button.is-copied {
    color: var(--muted);
  }

  .path button:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .path button {
      text-decoration: none;
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 calc(100% - 0.08em);
      background-size: 0 1px;
    }

    .path button:hover,
    .path button:focus-visible {
      background-size: 100% 1px;
    }
  }

  @media (hover: hover) and (pointer: fine) and (
      prefers-reduced-motion: no-preference
    ) {
    .path button {
      transition: background-size 180ms var(--ease-out);
    }
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (any-pointer: coarse) {
    .path a,
    .path button {
      display: inline-grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      vertical-align: middle;
    }
  }
</style>

<script>
  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return;
      } catch {
        // Some browsers reject the async API without a secure context.
      }
    }

    const area = document.createElement("textarea");
    area.value = text;
    area.setAttribute("readonly", "");
    area.style.position = "fixed";
    area.style.left = "-1000px";
    document.body.append(area);
    area.select();
    const ok = document.execCommand("copy");
    area.remove();
    if (!ok) throw new Error("copy failed");
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".path button[data-path]",
  )) {
    const label = button.querySelector<HTMLElement>(".label");
    const status = button.parentElement?.querySelector<HTMLElement>(".sr");
    if (!label) continue;
    const original = label.textContent ?? "";
    let timer = 0;

    button.addEventListener("click", async () => {
      const path = button.dataset.path;
      if (!path) return;
      try {
        await copyText(path);
      } catch {
        return;
      }
      window.clearTimeout(timer);
      label.textContent = "copied";
      button.classList.add("is-copied");
      if (status) status.textContent = `copied ${path}`;
      timer = window.setTimeout(() => {
        label.textContent = original;
        button.classList.remove("is-copied");
        if (status) status.textContent = "";
      }, 1000);
    });
  }
</script>

---
interface Props {
  segments: { label: string; href: string }[];
}

const { segments } = Astro.props;
const trail = [{ label: "~", href: "/" }, ...segments];
---

<nav class="path" aria-label="Breadcrumb">
  {trail.map((s, i) => (
    <>
      {i > 0 && (
        <span class="sep" aria-hidden="true">
          /
        </span>
      )}
      {i < trail.length - 1 ? (
        <a href={s.href}>{s.label}</a>
      ) : (
        <span aria-current="page">{s.label}</span>
      )}
    </>
  ))}
</nav>

<style>
  .path {
    font-size: 0.875rem;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .path a,
  .sep {
    color: var(--muted);
  }
  @media (any-pointer: coarse) {
    .path a {
      display: inline-grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      vertical-align: middle;
    }
  }
</style>

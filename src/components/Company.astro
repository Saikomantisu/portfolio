---
import { Image } from "astro:assets";
import logo from "../assets/nexgen-logo.png";

interface Props {
  name: string;
  url: string;
  summary: string;
  stats?: { value: string; label: string }[];
}

const { name, url, summary, stats = [] } = Astro.props;
const host = new URL(url).host;
const id = "company-card";
---

<div class="card" id={id} role="tooltip" data-company-card>
  <span class="head">
    <Image class="logo" src={logo} width={40} densities={[1, 2]} alt="" />
    <span>
      <span class="title">{name.toLowerCase()}</span>
      <span class="host">{host}</span>
    </span>
  </span>
  <span class="bio">{summary.toLowerCase()}</span>
  {stats.length > 0 && (
    <span class="stats">
      {stats.map((s) => (
        <span class="stat">
          <b>{s.value}</b> {s.label.toLowerCase()}
        </span>
      ))}
    </span>
  )}
</div>

<style>
  .card {
    position: fixed;
    z-index: 20;
    left: 0;
    top: 0;
    display: grid;
    gap: 0.65rem;
    width: 18rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: #111;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.97);
    transform-origin: top left;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  .card.is-open {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out),
      visibility 0s;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .logo {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
  }

  .title {
    display: block;
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .host,
  .bio,
  .stat {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .host,
  .bio {
    display: block;
  }

  .bio {
    text-wrap: pretty;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat b {
    color: var(--fg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card.is-open {
      transform: none;
      transition:
        opacity 160ms var(--ease-out),
        visibility 0s linear 160ms;
    }

    .card.is-open {
      transition:
        opacity 160ms var(--ease-out),
        visibility 0s;
    }
  }
</style>

<script>
  const link = document.querySelector<HTMLAnchorElement>("[data-company-link]");
  const card = document.querySelector<HTMLElement>("[data-company-card]");

  if (link && card) {
    document.body.append(card);

    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const GAP = 10;
    const EDGE = 16;

    let over = false;
    let focused = false;
    let dismissed = false;

    const place = () => {
      const rect = link.getBoundingClientRect();
      const w = card.offsetWidth;
      const h = card.offsetHeight;
      const above =
        rect.bottom + GAP + h > innerHeight - EDGE &&
        rect.top - GAP - h >= EDGE;
      let x = rect.left;
      if (x + w > innerWidth - EDGE) x = Math.max(EDGE, rect.right - w);
      const y = above ? rect.top - GAP - h : rect.bottom + GAP;
      const originX = x <= rect.left + 1 ? "left" : "right";
      card.style.left = `${x}px`;
      card.style.top = `${y}px`;
      card.style.transformOrigin = `${above ? "bottom" : "top"} ${originX}`;
    };

    const sync = () => {
      const show = fine.matches && (over || focused) && !dismissed;
      if (show) place();
      card.classList.toggle("is-open", show);
    };

    link.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      over = true;
      sync();
    });
    link.addEventListener("pointerleave", () => {
      over = false;
      dismissed = false;
      sync();
    });
    link.addEventListener("focusin", () => {
      if (!link.matches(":focus-visible")) return;
      focused = true;
      dismissed = false;
      sync();
    });
    link.addEventListener("focusout", () => {
      focused = false;
      dismissed = false;
      sync();
    });
    window.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || (!over && !focused)) return;
      dismissed = true;
      sync();
    });
    const follow = () => {
      if (card.classList.contains("is-open")) place();
    };
    window.addEventListener("scroll", follow, { passive: true });
    window.addEventListener("resize", follow);
    fine.addEventListener("change", sync);
  }
</script>

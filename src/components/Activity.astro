---
interface Props {
  user: string;
}

const { user } = Astro.props;
const WEEKS = 53;
---

<div class="activity" data-user={user}>
  <p class="bars" role="img" aria-label="GitHub contributions in the past year">
    {Array.from({ length: WEEKS }, () => <span class="idle" />)}
  </p>
  <p class="caption">contributions in the past year</p>
</div>

<style>
  .activity {
    padding-top: 1.5em;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 2.5rem;
    margin: 0;
  }

  .bars :global(span) {
    flex: 1;
    height: calc(var(--level, 1) / 8 * 100%);
    background: var(--muted);
  }

  .bars :global(.idle) {
    opacity: 0.4;
  }

  .caption {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>

<script>
  const LEVELS = 8;

  type Day = { date: string; count: number };

  for (const el of document.querySelectorAll<HTMLElement>(".activity[data-user]")) {
    const bars = el.querySelector<HTMLElement>(".bars");
    const caption = el.querySelector<HTMLElement>(".caption");
    if (!bars || !caption) continue;

    fetch(`https://github-contributions-api.jogruber.de/v4/${el.dataset.user}?y=last`)
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then(({ total, contributions }: { total: { lastYear: number }; contributions: Day[] }) => {
        const weeks: { start: string; count: number }[] = [];
        contributions.forEach((day, i) => {
          if (i % 7 === 0) weeks.push({ start: day.date, count: 0 });
          weeks[weeks.length - 1].count += day.count;
        });

        const busiest = Math.max(1, ...weeks.map((w) => w.count));
        bars.replaceChildren(
          ...weeks.map((w) => {
            const bar = document.createElement("span");
            const level = w.count ? 1 + Math.ceil(Math.sqrt(w.count / busiest) * (LEVELS - 1)) : 1;
            bar.style.setProperty("--level", String(level));
            bar.title = `${w.count} contribution${w.count === 1 ? "" : "s"}, week of ${w.start}`;
            if (!w.count) bar.className = "idle";
            return bar;
          }),
        );

        bars.setAttribute("aria-label", `${total.lastYear} contributions on GitHub in the past year`);
        caption.textContent = `${total.lastYear} contributions in the past year`;
      })
      .catch(() => (el.hidden = true));
  }
</script>

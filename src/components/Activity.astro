---
interface Props {
  user: string;
}

const { user } = Astro.props;
const WEEKS = 53;
---

<div class="activity" data-user={user} aria-busy="true">
  <p class="bars" role="img" aria-label="GitHub contributions in the last year">
    {Array.from({ length: WEEKS }, () => (
      <span class="week idle" aria-hidden="true">
        <span class="grow">
          <span class="fill"></span>
        </span>
      </span>
    ))}
  </p>
  <p class="caption" aria-hidden="true">Contributions in the last year</p>
  <p class="live" aria-live="polite"></p>
</div>

<style>
  .activity {
    position: relative;
    padding-top: 1.5em;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 2.5rem;
    margin: 0;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .bars:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
  }

  .bars :global(.week) {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
  }

  .bars :global(.grow) {
    width: 100%;
    height: calc(var(--level, 1) / 8 * 100%);
    transform-origin: bottom;
  }

  .bars :global(.fill) {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ink, #0e4429);
    transition: opacity 125ms ease;
  }

  .bars:has(:global(.is-current)) :global(.week:not(.is-current) .fill) {
    opacity: 0.6;
  }

  .bars :global(.week.is-current) :global(.fill) {
    background: var(--fg);
  }

  .caption {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bars.is-live :global(.grow) {
      animation: bar-in 0.4s var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 14ms);
    }

    .bars.is-ready:not(.is-live) :global(.grow) {
      transform: scaleY(0);
    }

    .bars :global(.fill) {
      transition: transform 120ms ease;
    }

    .bars :global(.week.is-current) :global(.fill) {
      transform: translateY(-4px);
    }
  }

  @media (hover: hover) and (pointer: fine) and (
      prefers-reduced-motion: no-preference
    ) {
    .bars :global(.week:has(+ .is-current) .fill),
    .bars :global(.is-current + .week .fill) {
      transform: translateY(-2px);
    }
  }

  @media (forced-colors: active) {
    .bars :global(.fill) {
      forced-color-adjust: none;
      background: CanvasText;
    }

    .bars :global(.week.is-current) :global(.fill) {
      background: Highlight;
    }
  }

  @keyframes bar-in {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
  const LEVELS = 8;
  // GitHub's dark contribution greens, quiet to busy.
  const GREENS = ["#0e4429", "#006d32", "#26a641", "#39d353"];

  function inkFor(level: number, count: number) {
    if (!count) return GREENS[0];
    const step = Math.round(((level - 1) / (LEVELS - 1)) * (GREENS.length - 1));
    return GREENS[Math.min(GREENS.length - 1, step)];
  }

  type Day = { date: string; count: number };
  type Week = { start: Date; end: Date; count: number };

  const dates = new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

  const labelFor = ({ start, end, count }: Week) =>
    `${dates.formatRange(start, end)} · ${count} contribution${count === 1 ? "" : "s"}`;

  for (const el of document.querySelectorAll<HTMLElement>(
    ".activity[data-user]",
  )) {
    const bars = el.querySelector<HTMLElement>(".bars");
    const caption = el.querySelector<HTMLElement>(".caption");
    const live = el.querySelector<HTMLElement>(".live");
    if (!bars || !caption || !live) continue;
    const { user } = el.dataset;

    fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`)
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then(
        ({
          total,
          contributions,
        }: {
          total: Record<string, number>;
          contributions: Day[];
        }) => {
          // Calendar weeks, Sunday to Saturday, like GitHub's own graph.
          const weeks: Week[] = [];
          for (const day of contributions) {
            const date = new Date(day.date);
            if (!weeks.length || date.getUTCDay() === 0) {
              weeks.push({ start: date, end: date, count: 0 });
            }
            const week = weeks[weeks.length - 1];
            week.end = date;
            week.count += day.count;
          }
          if (!weeks.length) throw new Error("Empty contribution calendar");

          const busiest = Math.max(1, ...weeks.map((week) => week.count));
          const columns = weeks.map((week, index) => {
            const column = document.createElement("span");
            column.className = week.count ? "week" : "week idle";
            column.dataset.count = String(week.count);
            column.dataset.label = labelFor(week);
            column.setAttribute("aria-hidden", "true");
            const level = week.count
              ? 1 + Math.ceil(Math.sqrt(week.count / busiest) * (LEVELS - 1))
              : 1;
            const grow = document.createElement("span");
            grow.className = "grow";
            grow.style.setProperty("--level", String(level));
            grow.style.setProperty("--i", String(index));
            grow.style.setProperty("--ink", inkFor(level, week.count));
            const fill = document.createElement("span");
            fill.className = "fill";
            grow.append(fill);
            column.append(grow);
            return column;
          });

          const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (!reduced) bars.classList.add("is-ready");
          bars.replaceChildren(...columns);
          if (!reduced) {
            const observer = new IntersectionObserver((entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              bars.classList.add("is-live");
              observer.disconnect();
            });
            observer.observe(bars);
          }
          bars.tabIndex = 0;
          bars.setAttribute("role", "group");
          const count = (total.lastYear ?? 0).toLocaleString("en-US");
          bars.setAttribute(
            "aria-label",
            `${count} contributions on GitHub in the last year`,
          );
          const rest = `${count} contributions in the last year`;
          caption.textContent = rest;
          el.removeAttribute("aria-busy");

          let current: HTMLElement | null = null;
          let pinned = false;
          let touchedAt = 0;
          let dragged = false;
          const afterTouch = () =>
            touchedAt !== 0 && performance.now() - touchedAt < 500;

          const textFor = (column: HTMLElement) => column.dataset.label ?? "";

          const select = (column: HTMLElement, announce = false) => {
            current?.classList.remove("is-current");
            column.classList.add("is-current");
            current = column;
            const text = textFor(column);
            caption.textContent = text;
            live.textContent = announce ? text : "";
          };

          const clear = () => {
            current?.classList.remove("is-current");
            current = null;
            pinned = false;
            caption.textContent = rest;
            live.textContent = "";
          };

          const columnFrom = (target: EventTarget | null) => {
            if (!(target instanceof Element)) return null;
            const column = target.closest<HTMLElement>(".week");
            return column && bars.contains(column) ? column : null;
          };

          // Touch moves are captured by the first bar, so find the week
          // under the finger from its x position instead of the target.
          const columnAt = (x: number) => {
            const bounds = bars.getBoundingClientRect();
            const index = Math.floor(
              ((x - bounds.left) / bounds.width) * columns.length,
            );
            return columns[Math.max(0, Math.min(index, columns.length - 1))];
          };

          bars.addEventListener("pointerdown", (event) => {
            if (event.pointerType === "mouse") return;
            touchedAt = performance.now();
            dragged = false;
          });

          bars.addEventListener("pointermove", (event) => {
            if (event.pointerType !== "mouse") {
              if (!event.buttons) return;
              const column = columnAt(event.clientX);
              if (column === current) return;
              dragged = true;
              pinned = true;
              touchedAt = performance.now();
              select(column);
              return;
            }
            if (afterTouch()) return;
            pinned = false;
            const column = columnFrom(event.target);
            if (column) select(column);
          });

          bars.addEventListener("pointerleave", (event) => {
            if (
              event.pointerType !== "mouse" ||
              afterTouch() ||
              pinned ||
              bars.matches(":focus")
            ) {
              return;
            }
            clear();
          });

          bars.addEventListener("pointerup", (event) => {
            const column = columnFrom(event.target);
            if (!column) return;
            if (event.pointerType === "mouse") {
              if (!afterTouch()) select(column);
              return;
            }
            if (dragged) {
              dragged = false;
              return;
            }
            if (current === column && pinned) clear();
            else {
              pinned = true;
              select(column);
            }
          });

          // A vertical swipe hands the gesture to the page scroll.
          bars.addEventListener("pointercancel", () => {
            if (dragged) clear();
            dragged = false;
          });

          document.addEventListener("pointerdown", (event) => {
            if (!pinned || el.contains(event.target as Node)) return;
            clear();
          });

          bars.addEventListener("focus", () => {
            if (current) return;
            const last = bars.querySelector<HTMLElement>(".week:last-child");
            if (last) select(last, true);
          });

          bars.addEventListener("blur", () => {
            if (!pinned) clear();
          });

          bars.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
              clear();
              bars.blur();
              return;
            }
            const list = Array.from(
              bars.querySelectorAll<HTMLElement>(":scope > .week"),
            );
            if (!list.length) return;
            const index = current ? list.indexOf(current) : list.length - 1;
            const at = index < 0 ? list.length - 1 : index;
            let next = at;
            if (event.key === "ArrowRight")
              next = Math.min(list.length - 1, at + 1);
            else if (event.key === "ArrowLeft") next = Math.max(0, at - 1);
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = list.length - 1;
            else return;
            event.preventDefault();
            select(list[next], true);
          });
        },
      )
      .catch(() => {
        el.hidden = true;
      });
  }
</script>

---
import type { CollectionEntry } from "astro:content";
import { lsDate, readingTime } from "../data/posts";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ul class="ls">
  {posts.map((post) => (
    <li>
      <time class="meta" datetime={post.data.date.toISOString()}>
        {lsDate(post.data.date)}
      </time>
      <span class="meta">{readingTime(post.body)}</span>
      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
    </li>
  ))}
</ul>

<style>
  .ls {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
  }

  .meta {
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: auto 1fr;
    }

    a {
      grid-column: 1 / -1;
    }
  }
</style>

---
import { Image } from "astro:assets";
import avatar from "../assets/profile-avatar.png";
import landscape from "../assets/twilight-poppies.png";
import Activity from "../components/Activity.astro";
import Peek from "../components/Peek.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { getLinks, getProfile, getProjects } from "../data/profile";
import Base from "../layouts/Base.astro";

const { name, role, company, timeZone, intro, usually, github, kofi } =
  await getProfile();
const projects = await getProjects({ featured: true });
const links = await getLinks();
const posts = (await getPosts()).slice(0, 3);
---

<Base title={name} description={intro}>
  <main>
    <header data-reveal="self">
      <Image
        class="cover"
        src={landscape}
        widths={[448, 704, 1408]}
        sizes="(max-width: 692px) 100vw, 692px"
        alt="Building new things"
        loading="eager"
        fetchpriority="high"
      />
      <div class="profile-row">
        <Image
          class="avatar"
          src={avatar}
          width={88}
          densities={[1, 2]}
          alt=""
        />
        <h1>{name}</h1>
        <p class="role">
          {role}{" · "}founder of{" "}
          <a href={company.url}>{company.name.toLowerCase()} ↗</a>
        </p>
        <p class="now" data-tz={timeZone} hidden></p>
      </div>
      <p class="late" hidden>you're up late too. good.</p>
      <p class="intro">{intro}</p>
      <p class="usually">usually: {usually.join(", ").toLowerCase()}</p>
    </header>

    <section data-reveal>
      <h2>work</h2>
      <ul data-peek-list>
        {projects.map((p) => (
          <li data-peek={p.image ? p.name : undefined}>
            <a href={p.url}>{p.name}</a>
            <p class="muted">{p.description}</p>
            {p.image && (
              <figure class="thumb" aria-hidden="true">
                <figcaption>
                  <span class="dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="path">~/work/{p.name}</span>
                </figcaption>
                <Image
                  src={p.image}
                  alt=""
                  widths={[480, 720, 1080, 1384]}
                  sizes="(max-width: 740px) calc(100vw - 3rem), 692px"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
          </li>
        ))}
      </ul>
      <p><span class="muted">$</span> <a href="/projects/">cd projects</a></p>
      <div class="github">
        <Activity user={github} />
      </div>
    </section>

    {posts.length > 0 && (
      <section data-reveal>
        <h2>writing</h2>
        <PostList posts={posts} />
        <p>
          <span class="muted">$</span> <a href="/blog/">cd writing</a>
        </p>
      </section>
    )}

    <section data-reveal>
      <h2>elsewhere</h2>
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.url}>{l.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="muted" data-reveal="self">
      © {new Date().getFullYear()} {name} · <a href={kofi}>ko-fi ↗</a>
    </footer>

    <Peek items={projects} />
  </main>
</Base>
<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(1.5rem, 7vw, 4rem) var(--gutter-right) 4rem
      var(--gutter-left);
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .muted {
    color: var(--muted);
  }

  h1,
  h2 {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg);
    margin: 0;
    text-transform: lowercase;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .cover {
    display: block;
    width: calc(100% + var(--gutter-left) + var(--gutter-right));
    margin-left: calc(-1 * var(--gutter-left));
    height: auto;
    border-radius: 8px;
  }

  @media (max-width: 692px) {
    main {
      padding-top: 0;
    }

    .cover {
      border-radius: 0;
    }
  }

  .profile-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "avatar status"
      "name name"
      "role role";
    align-items: end;
    column-gap: 1rem;
  }

  .profile-row h1 {
    grid-area: name;
    margin-top: 0.5rem;
  }

  .avatar {
    grid-area: avatar;
    display: block;
    position: relative;
    margin-top: -2rem;
    width: clamp(4.25rem, 15vw, 5.5rem);
    height: auto;
    border: 4px solid var(--bg);
    border-radius: 50%;
  }

  .intro {
    margin-top: 2rem;
  }

  .role {
    grid-area: role;
    color: var(--muted);
    font-size: 0.875rem;
    text-transform: lowercase;
  }

  .role a {
    white-space: nowrap;
  }

  .now {
    grid-area: status;
    text-align: right;
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 30rem) {
    .profile-row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "avatar" "name" "role" "status";
    }

    .now {
      margin-top: 0.75rem;
      text-align: left;
      line-height: 1.5;
    }

    .role {
      margin-top: 0.75rem;
      line-height: 1.5;
    }
  }

  .late {
    margin-top: 1rem;
    color: var(--fg);
    font-size: 0.875rem;
    font-style: italic;
  }

  section {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  header + section {
    margin-top: clamp(2rem, 5vw, 2.75rem);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li p {
    font-size: 0.875rem;
  }

  .thumb {
    margin: 0.75rem 0 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: #111;
  }

  .thumb figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .thumb .dots {
    display: flex;
    gap: 4px;
  }

  .thumb .dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .thumb .path {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Prints in top to bottom as it scrolls into view, like the hover window. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .thumb img {
        animation: print linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  [data-peek-list] > li {
    position: relative;
  }

  /* The project has one native link and one focus stop, including its thumbnail. */
  [data-peek-list] > li > a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Narrow windows and touch devices use the inline thumbnail. */
  @media (hover: hover) and (pointer: fine) and (min-width: 46rem) and (
      min-height: 24rem
    ) {
    .thumb {
      display: none;
    }
  }

  :where([data-peek-list]) > .is-current > a {
    text-decoration-color: var(--fg);
  }

  .usually {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .github {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .links a {
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: lowercase;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--fg);
    }
  }

  footer {
    margin-top: 5rem;
    font-size: 0.875rem;
    text-transform: lowercase;
  }
  @media (any-pointer: coarse) {
    .links {
      row-gap: 0;
    }

    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

<script>
  import { reveal } from "../scripts/reveal";

  reveal();

  const now = document.querySelector<HTMLElement>(".now");
  if (now) {
    const tz = now.dataset.tz;
    const clock = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: tz,
    });
    const hourIn = new Intl.DateTimeFormat("en-GB", {
      hour: "numeric",
      hourCycle: "h23",
      timeZone: tz,
    });
    const update = () => {
      const date = new Date();
      const h = Number(hourIn.format(date));
      const doing =
        h >= 21 || h < 5
          ? "probably coding"
          : h < 11
            ? "probably asleep"
            : "probably around";
      now.textContent = `${clock.format(date)} in sri lanka · ${doing}`;
    };
    update();
    now.hidden = false;
    setInterval(update, 60_000);
  }

  const hour = new Date().getHours();
  const late = document.querySelector<HTMLElement>(".late");
  if (late && hour < 5) late.hidden = false;
</script>

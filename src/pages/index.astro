---
import { Image } from "astro:assets";
import avatar from "../assets/profile-avatar.png";
import landscape from "../assets/twilight-poppies.png";
import Activity from "../components/Activity.astro";
import Company from "../components/Company.astro";
import Peek from "../components/Peek.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { getLinks, getProfile, getProjects } from "../data/profile";
import Base from "../layouts/Base.astro";

const { name, role, company, timeZone, intro, usually, github, kofi } =
  await getProfile();
const projects = await getProjects({ featured: true });
const links = await getLinks();
const posts = (await getPosts()).slice(0, 3);
---

<Base title={name} description={intro}>
  <main>
    <header data-reveal="self">
      <div class="hero">
        <Image
          class="cover"
          src={landscape}
          widths={[448, 704, 1408]}
          sizes="(max-width: 692px) 100vw, 692px"
          alt="Building new things"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-night" aria-hidden="true"></div>
        <p class="now" data-tz={timeZone} hidden></p>
      </div>
      <div class="profile-row">
        <Image
          class="avatar"
          src={avatar}
          width={88}
          densities={[1, 2]}
          alt=""
        />
        <h1>{name}</h1>
        <p class="role">
          {role}{" · "}founder of{" "}
          <a
            href={company.url}
            data-company-link
            aria-describedby="company-card"
          >
            {`${company.name.toLowerCase()} ↗`}
          </a>
        </p>
        <Company
          name={company.name}
          url={company.url}
          summary={company.summary}
          stats={company.stats}
        />
      </div>
      <p class="late" hidden>you're up late too. good.</p>
      <p class="intro">{intro}</p>
      <p class="usually">usually: {usually.join(", ").toLowerCase()}</p>
    </header>

    <section data-reveal>
      <h2>work</h2>
      <ul data-peek-list>
        {projects.map((p) => (
          <li data-peek={p.image ? p.name : undefined}>
            <a href={p.url}>{p.name}</a>
            <p class="muted">{p.description}</p>
            {p.image && (
              <figure class="thumb" aria-hidden="true">
                <figcaption>
                  <span class="dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="path">~/work/{p.name}</span>
                </figcaption>
                <Image
                  src={p.image}
                  alt=""
                  widths={[480, 720, 1080, 1384]}
                  sizes="(max-width: 740px) calc(100vw - 3rem), 692px"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
          </li>
        ))}
      </ul>
      <p class="cmd">
        <span class="prompt">$</span> <a href="/projects/">cd projects</a>
      </p>
      <Activity user={github} />
    </section>

    {posts.length > 0 && (
      <section data-reveal>
        <h2>writing</h2>
        <PostList posts={posts} />
        <p class="cmd">
          <span class="prompt">$</span> <a href="/blog/">cd writing</a>
        </p>
      </section>
    )}

    <section data-reveal>
      <h2>elsewhere</h2>
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.url}>{l.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="muted" data-reveal="self">
      © {new Date().getFullYear()} {name} · <a href={kofi}>ko-fi ↗</a>
    </footer>

    <Peek items={projects} />
  </main>
</Base>
<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(1.5rem, 7vw, 4rem) var(--gutter-right) 4rem
      var(--gutter-left);
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .muted {
    color: var(--muted);
  }

  h1,
  h2 {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg);
    margin: 0;
    text-transform: lowercase;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .cover {
    display: block;
    width: calc(100% + var(--gutter-left) + var(--gutter-right));
    margin-left: calc(-1 * var(--gutter-left));
    height: auto;
    border-radius: 8px;
  }

  .hero-night {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--gutter-left));
    width: calc(100% + var(--gutter-left) + var(--gutter-right));
    border-radius: 8px;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  .hero.is-night .hero-night {
    opacity: 0.14;
  }

  @media (max-width: 692px) {
    main {
      padding-top: 0;
    }

    .cover,
    .hero-night {
      border-radius: 0;
    }
  }

  .hero {
    position: relative;
  }

  .profile-row {
    display: grid;
  }

  .profile-row h1 {
    margin-top: 0.5rem;
  }

  .avatar {
    display: block;
    position: relative;
    z-index: 2;
    margin-top: -2rem;
    width: clamp(4.25rem, 15vw, 5.5rem);
    height: auto;
    border: 4px solid var(--bg);
    border-radius: 50%;
  }

  .intro {
    margin-top: 2rem;
  }

  .role {
    color: var(--muted);
    font-size: 0.875rem;
    text-transform: lowercase;
  }

  .role a {
    white-space: nowrap;
  }

  .now {
    position: absolute;
    z-index: 2;
    top: calc(100% + 1rem);
    right: 0;
    max-width: calc(100% - 6.5rem);
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: right;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  @media (max-width: 30rem) {
    .role {
      margin-top: 0.75rem;
      line-height: 1.5;
    }
  }

  .late {
    margin-top: 1rem;
    color: var(--fg);
    font-size: 0.875rem;
    font-style: italic;
  }

  main > :is(section, footer) {
    margin-top: calc(clamp(2.5rem, 5vw, 3rem) + 0.25rem);
  }

  section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li p {
    font-size: 0.875rem;
  }

  .thumb {
    margin: 0.75rem 0 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: #111;
  }

  .thumb figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .thumb .dots {
    display: flex;
    gap: 4px;
  }

  .thumb .dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .thumb .path {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Prints in top to bottom as it scrolls into view, like the hover window. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .thumb img {
        animation: print linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  [data-peek-list] > li {
    position: relative;
  }

  /* The project has one native link and one focus stop, including its thumbnail. */
  [data-peek-list] > li > a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Narrow windows and touch devices use the inline thumbnail. */
  @media (hover: hover) and (pointer: fine) and (min-width: 46rem) and (
      min-height: 24rem
    ) {
    .thumb {
      display: none;
    }
  }

  :where([data-peek-list]) > .is-current > a {
    text-decoration-color: var(--fg);
    background-size: 100% 1px;
  }

  .usually {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .links a {
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: lowercase;
  }

  @media (hover: hover) and (pointer: fine) and (
      prefers-reduced-motion: no-preference
    ) {
    .links a {
      transition:
        background-size 180ms var(--ease-out),
        color 150ms var(--ease-out);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--fg);
    }
  }

  footer {
    font-size: 0.875rem;
    text-transform: lowercase;
  }
  @media (any-pointer: coarse) {
    .links {
      row-gap: 0;
    }

    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

<script>
  import { TextMorph } from "torph";
  import { reveal } from "../scripts/reveal";

  reveal();

  const now = document.querySelector<HTMLElement>(".now");
  if (now) {
    const tz = now.dataset.tz ?? "UTC";
    const morph = new TextMorph({
      element: now,
      duration: 400,
      ease: "cubic-bezier(0.23, 1, 0.32, 1)",
      locale: "en",
      respectReducedMotion: true,
    });
    const clock = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: tz,
    });

    const hourIn = (date: Date, timeZone: string) => {
      const value = Number(
        new Intl.DateTimeFormat("en-GB", {
          hour: "numeric",
          hourCycle: "h23",
          timeZone,
        }).format(date),
      );
      return value === 24 ? 0 : value;
    };

    const zoneOffsetMinutes = (date: Date, timeZone: string) => {
      const parts = new Intl.DateTimeFormat("en-US", {
        timeZone,
        hourCycle: "h23",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      }).formatToParts(date);
      const pick = (type: Intl.DateTimeFormatPartTypes) =>
        Number(parts.find((part) => part.type === type)?.value);
      const hour = pick("hour") === 24 ? 0 : pick("hour");
      const asUTC = Date.UTC(
        pick("year"),
        pick("month") - 1,
        pick("day"),
        hour,
        pick("minute"),
        pick("second"),
      );
      return Math.round((asUTC - date.getTime()) / 60000);
    };

    const formatOffset = (delta: number) => {
      const abs = Math.abs(delta);
      const hours = Math.floor(abs / 60);
      const minutes = abs % 60;
      const amount = [hours ? `${hours}h` : "", minutes ? `${minutes}m` : ""]
        .filter(Boolean)
        .join(" ");
      const relation = delta > 0 ? "ahead of you" : "behind you";
      return `${amount} ${relation}`;
    };

    const update = () => {
      const date = new Date();
      const h = hourIn(date, tz);
      const parts = clock.formatToParts(date);
      const hour = parts.find((part) => part.type === "hour")?.value ?? "";
      const minute = parts.find((part) => part.type === "minute")?.value ?? "";
      const delta = zoneOffsetMinutes(date, tz) + date.getTimezoneOffset();
      const time = `${hour}:${minute} in sri lanka`;
      morph.update(delta === 0 ? time : `${time} · ${formatOffset(delta)}`);
      now.closest(".hero")?.classList.toggle("is-night", h >= 21 || h < 5);
    };

    update();
    now.hidden = false;
    setInterval(update, 60_000);

    const late = document.querySelector<HTMLElement>(".late");
    if (late) {
      const date = new Date();
      const there = hourIn(date, tz);
      const thereUp = there >= 21 || there < 5;
      if (date.getHours() < 5 && thereUp) late.hidden = false;
    }
  }
</script>

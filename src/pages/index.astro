---
import Activity from "../components/Activity.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../data/posts";
import { getLinks, getProfile, getProjects } from "../data/profile";
import Base from "../layouts/Base.astro";

const { name, role, company, timeZone, intro, usually, github } =
  await getProfile();
const projects = await getProjects({ featured: true });
const links = await getLinks();
const posts = (await getPosts()).slice(0, 3);
const reposUrl = `https://github.com/${github}?tab=repositories`;
---

<Base title={name} description={intro}>
  <main>
    <header data-reveal>
      <h1>{name}</h1>
      <p class="role">
        {role}
        · founder of <a href={company.url}>{company.name.toLowerCase()} ↗</a>
      </p>
      <p class="now" data-tz={timeZone} hidden></p>
      <p class="late" hidden>you're up late too. good.</p>
    </header>

    <section data-reveal>
      <p>{intro}</p>
      <p class="usually">usually: {usually.join(", ").toLowerCase()}</p>
    </section>

    <section data-reveal>
      <h2>work</h2>
      <ul>
        {projects.map((p) => (
          <li>
            <a href={p.url}>{p.name}</a>
            <p class="muted">{p.description}</p>
          </li>
        ))}
      </ul>
      <p><span class="muted">$</span> <a href="/projects/">cd projects</a></p>
      <div class="github">
        <Activity user={github} />
        <p><span class="muted">$</span> <a href={reposUrl}>open github</a></p>
      </div>
    </section>

    {posts.length > 0 && (
      <section data-reveal>
        <h2>writing</h2>
        <PostList posts={posts} />
        <p>
          <span class="muted">$</span> <a href="/blog/">cd writing</a>
        </p>
      </section>
    )}

    <section data-reveal>
      <h2>elsewhere</h2>
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.url}>{l.label}</a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="muted" data-reveal="self">
      © {new Date().getFullYear()} {name}<span class="unseen" aria-hidden="true"
        >{" you weren't supposed to find this."}</span
      >
    </footer>
  </main>
</Base>
<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(4rem, 14vw, 7rem) var(--gutter-right) 4rem var(--gutter-left);
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  .muted {
    color: var(--muted);
  }

  h1,
  h2 {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--fg);
    margin: 0;
    text-transform: lowercase;
  }

  h1 {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .role {
    color: var(--muted);
    font-size: 0.875rem;
    text-transform: lowercase;
  }

  .role a {
    white-space: nowrap;
  }

  .now {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .late {
    margin-top: 1rem;
    color: var(--fg);
    font-size: 0.875rem;
    font-style: italic;
  }

  .now + .late {
    margin-top: 0.25rem;
  }

  section {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  h2 {
    margin-bottom: 0.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li p {
    font-size: 0.875rem;
  }

  .usually {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .github {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .links a {
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: lowercase;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--fg);
    }
  }

  .unseen {
    display: none;
    color: var(--bg);
  }

  :global(.halloween) .unseen {
    display: inline;
  }

  footer {
    margin-top: 5rem;
    font-size: 0.875rem;
    text-transform: lowercase;
  }
</style>

<script>
  import { reveal } from "../scripts/reveal";

  reveal();

  const spooky = document.documentElement.classList.contains("halloween");
  const now = document.querySelector<HTMLElement>(".now");
  if (now) {
    const tz = now.dataset.tz;
    const clock = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: tz,
    });
    const hourIn = new Intl.DateTimeFormat("en-GB", {
      hour: "numeric",
      hourCycle: "h23",
      timeZone: tz,
    });
    const update = () => {
      const date = new Date();
      const h = Number(hourIn.format(date));
      const doing =
        spooky && h < 3
          ? "probably not alone"
          : h >= 21 || h < 5
            ? "probably coding"
            : h < 11
              ? "probably asleep"
              : "probably around";
      now.textContent = `${clock.format(date)} in sri lanka · ${doing}`;
    };
    update();
    now.hidden = false;
    setInterval(update, 60_000);
  }

  const hour = new Date().getHours();
  const late = document.querySelector<HTMLElement>(".late");
  if (late && hour < 5) {
    if (spooky) late.textContent = "you're up late too. so is something else.";
    late.hidden = false;
  }
</script>

---
import { render } from "astro:content";
import Path from "../../components/Path.astro";
import { formatDate, getPosts } from "../../data/posts";
import { getProfile } from "../../data/profile";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { name } = await getProfile();
---

<Base title={`${post.data.title} - ${name}`} description={post.data.description}>
  <div class="progress" aria-hidden="true"></div>
  <main>
    <div data-reveal>
      <Path
        segments={[
          { label: "writing", href: "/blog/" },
          { label: post.id, href: `/blog/${post.id}/` },
        ]}
      />
    </div>

    <header data-reveal>
      <h1>{post.data.title}</h1>
      <time class="muted" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
        {post.data.draft && " · draft"}
      </time>
    </header>

    <article class="prose" data-reveal="self">
      <Content />
    </article>

    <footer class="eof">
      <p class="muted">EOF</p>
      <p><span class="muted">$</span> <a href="/blog/">cd ..</a></p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(3rem, 10vw, 5rem) var(--gutter-right) 6rem var(--gutter-left);
  }

  header {
    margin: 3.5rem 0 3rem;
  }

  h1 {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--fg);
    margin: 0 0 0.25rem;
    text-wrap: balance;
  }

  time {
    font-size: 0.875rem;
  }

  .muted {
    color: var(--muted);
  }

  .eof {
    margin-top: 4rem;
  }

  .eof p {
    margin: 0;
  }

  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      height: 1px;
      z-index: 20;
      background: var(--fg);
      opacity: 0.5;
      transform-origin: left;
      animation: read-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .prose > :global(*) {
    margin: 0;
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(h5),
  .prose :global(h6) {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--fg);
    margin-top: 2.5em;
  }

  .prose :global(strong) {
    font-weight: 700;
    color: var(--fg);
  }

  .prose :global(a) {
    color: var(--fg);
    text-decoration-color: var(--underline);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  .prose :global(ul li::marker) {
    content: "- ";
    color: var(--muted);
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--underline);
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(:not(pre) > code) {
    color: var(--fg);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2.5em 0;
  }
</style>

<script>
  import { reveal } from "../../scripts/reveal";

  reveal();
</script>
